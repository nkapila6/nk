{
  "name": "github-activity",
  "version": "1.0.0",
  "private": true,
  "description": "Live public GitHub activity feed on selected pages",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./components": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "quartz": {
    "name": "github-activity",
    "displayName": "GitHub Activity",
    "category": "component",
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultEnabled": true,
    "defaultOptions": {},
    "components": {
      "GithubActivity": {
        "displayName": "GitHub Activity",
        "defaultPosition": "beforeBody",
        "defaultPriority": 40
      }
    }
  }
}
