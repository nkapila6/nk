{
  "name": "ascii-art",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted ascii.rest pieces via the <ascii-art> tag",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./components": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "quartz": {
    "name": "ascii-art",
    "displayName": "ASCII Art",
    "category": "component",
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultEnabled": true,
    "defaultOptions": {},
    "components": {
      "AsciiArt": {
        "displayName": "ASCII Art",
        "defaultPosition": "footer",
        "defaultPriority": 40
      }
    }
  }
}
